  "content": {
    "stats": [
      {
        "value": "1 500 TWh",
        "text": "demande mondiale d'électricité de l'IA possible d'ici 2035"
      },
      {
        "value": "≈ 3 ×",
        "text": "la consommation électrique annuelle de la France"
      },
      {
        "value": "÷ 2",
        "text": "avec une IA frugale généralisée"
      }
    ],
    "statsSource": "Source : Schneider Electric, « Artificial Intelligence and Electricity, A System Dynamics Approach », 2024.",
    "practices": [
      {
        "title": "Usages et modèles",
        "color": "#0088ce",
        "items": [
          {
            "icon": "circle-help",
            "title": "Challenger le besoin",
            "text": "Questionner le recours à l'IA générative pour le projet."
          },
          {
            "icon": "crosshair",
            "title": "Modèles spécialisés",
            "text": "Privilégier les modèles spécialisés aux modèles généralistes."
          },
          {
            "icon": "workflow",
            "title": "Le bon modèle à chaque étape",
            "text": "Pour un même processus métier, cibler le modèle adapté à chaque étape."
          }
        ]
      },
      {
        "title": "Optimiser l'infrastructure",
        "color": "#009aa6",
        "items": [
          {
            "icon": "leaf",
            "title": "Datacenters responsables",
            "text": "Exiger un hébergement en France, ou à défaut en Europe, dans un datacenter alimenté en électricité bas carbone (location based). Suivre PUE et WUE."
          }
        ]
      },
      {
        "title": "Optimiser l'inférence",
        "color": "#a1006b",
        "items": [
          {
            "icon": "message-square-text",
            "title": "Prompts",
            "text": "Former les utilisateurs ; privilégier une architecture qui reformule et optimise les prompts."
          },
          {
            "icon": "scissors",
            "title": "Tokens générés",
            "text": "Limiter la verbosité du modèle et borner le nombre de tokens de réponse."
          },
          {
            "icon": "route",
            "title": "Routage automatique",
            "text": "Router vers le modèle optimal selon l'usage, préférer des SLM aux LLM quand c'est possible."
          },
          {
            "icon": "hard-drive",
            "title": "Besoins de calcul",
            "text": "Mettre en cache les réponses récurrentes ; choisir une architecture « Mixture of Experts »."
          },
          {
            "icon": "laptop",
            "title": "Exécution en local",
            "text": "Évaluer l'exécution de certains cas d'usage via des SLM sur le poste utilisateur."
          },
          {
            "icon": "layers",
            "title": "Optimisation du RAG",
            "text": "Limiter la taille et le nombre de chunks."
          },
          {
            "icon": "history",
            "title": "Compression d'historique",
            "text": "Résumer régulièrement l'historique pour limiter les tokens d'entrée."
          },
          {
            "icon": "activity",
            "title": "Streaming de réponses",
            "text": "Afficher progressivement la réponse pour limiter les tokens de sortie."
          },
          {
            "icon": "eye",
            "title": "Observabilité",
            "text": "Mesurer la pertinence des entrées, la qualité des réponses et la justesse du routage (ex. LLM-as-a-Judge)."
          },
          {
            "icon": "chart-line",
            "title": "Piloter l'inférence",
            "text": "Mesurer régulièrement l'impact pour suivre la progression et ajuster l'usage."
          }
        ]
      },
      {
        "title": "Sensibiliser les utilisateurs",
        "color": "#e05206",
        "items": [
          {
            "icon": "pen-line",
            "title": "Construction du prompt",
            "text": "Former au prompt engineering, réutiliser les prompts et templates déjà éprouvés."
          },
          {
            "icon": "image-off",
            "title": "Génération d'images",
            "text": "Quand le texte suffit, éviter de générer ou d'insérer images et vidéos."
          },
          {
            "icon": "combine",
            "title": "Factorisation",
            "text": "Regrouper plusieurs demandes en une seule requête."
          }
        ]
      }
    ],
